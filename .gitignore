# Basic gitignore
/[Tt]emp/
*.exe
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Claude Code settings
#   settings.json holds this machine's absolute marketplace path, written by setup.py.
#   It is machine-specific and must not be shared.
.claude/settings.json
.claude/settings.local.json

# Migrations — packages, manifests and the ledger are local (see migrations/README.md)
migrations/in/*
migrations/out/*
migrations/applied/*
migrations/manifests/*
migrations/.staging/
migrations/ledger.md
!migrations/*/.gitkeep

# memory-core sync — machine-only
/device/
